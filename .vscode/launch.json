{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "data: generate mock cohort",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/make_mock_data.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "data: validate data",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/validate_data.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "smoke: single fast training",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_training.py",
            "args": ["--config", "configs/transformer_cbam.yaml", "--fast"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "CUDA_VISIBLE_DEVICES": "0" },
            "justMyCode": false
        },
        {
            "name": "train: full single run (Transformer+CBAM)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_training.py",
            "args": ["--config", "configs/transformer_cbam.yaml", "--seed", "0"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "CUDA_VISIBLE_DEVICES": "0" },
            "justMyCode": false
        },
        {
            "name": "tune: Optuna tuning (fast)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_tuning.py",
            "args": ["--config", "configs/transformer_cbam.yaml", "--fast"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "CUDA_VISIBLE_DEVICES": "0" },
            "justMyCode": false
        },
        {
            "name": "holdout: 100 runs (Transformer pair)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_holdout.py",
            "args": [
                "--configs",
                "configs/transformer.yaml",
                "configs/transformer_cbam.yaml"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": { "CUDA_VISIBLE_DEVICES": "0" },
            "justMyCode": false
        },
        {
            "name": "summarize: tables (Table2/top20)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/summarize.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "analysis: Mantel+Lasso+SHAP",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_analysis.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
